{
  "name": "threadhaus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/server.js\" \"npm --prefix client run dev\"",
    "start": "node server/server.js",
    "seed": "node server/seed.js",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "mongodb-memory-server": "^10.1.4"
  }
}